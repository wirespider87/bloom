#ifndef BLOOM_INTERNAL_BUILD
#define BLOOM_INTERNAL_BUILD
#endif

#include "core/graphics/draw/draw.h"
#include "core/graphics/font/font.h"
#include "core/runtime/context/context.h"
#include <string.h>
#include <math.h>

#ifndef M_PI
#define M_PI 3.14159265358979323846
#endif

void bloom_draw_list_init(bloom_draw_list *dl, bloom_vertex *verts, bloom_u32 vert_cap,
                          bloom_draw_idx *idxs, bloom_u32 idx_cap,
                          bloom_draw_cmd *cmds, bloom_u32 cmd_cap)
{
    dl->vertices = verts;
    dl->vertex_count = 0;
    dl->vertex_capacity = vert_cap;
    dl->indices = idxs;
    dl->index_count = 0;
    dl->index_capacity = idx_cap;
    dl->commands = cmds;
    dl->cmd_count = 0;
    dl->cmd_capacity = cmd_cap;
    dl->clip_depth = 0;
    dl->current_texture = 0;
}

void bloom_draw_list_clear(bloom_draw_list *dl)
{
    dl->vertex_count = 0;
    dl->index_count = 0;
    dl->cmd_count = 0;
    dl->clip_depth = 0;
}

void bloom_draw_list_append(bloom_draw_list *dst, const bloom_draw_list *src)
{
    bloom_u32 vertex_base;
    bloom_u32 index_base;
    bloom_u32 i;

    if (!dst || !src || src->vertex_count == 0 || src->index_count == 0 || src->cmd_count == 0)
    {
        return;
    }

    if (dst->vertex_count + src->vertex_count > dst->vertex_capacity ||
        dst->index_count + src->index_count > dst->index_capacity ||
        dst->cmd_count + src->cmd_count > dst->cmd_capacity)
    {
        return;
    }

    vertex_base = dst->vertex_count;
    index_base = dst->index_count;

    memcpy(&dst->vertices[dst->vertex_count], src->vertices, sizeof(bloom_vertex) * src->vertex_count);
    dst->vertex_count += src->vertex_count;

    for (i = 0; i < src->index_count; ++i)
    {
        dst->indices[index_base + i] = (bloom_draw_idx)(src->indices[i] + vertex_base);
    }
    dst->index_count += src->index_count;

    memcpy(&dst->commands[dst->cmd_count], src->commands, sizeof(bloom_draw_cmd) * src->cmd_count);
    dst->cmd_count += src->cmd_count;
}

void bloom_draw_list_prepend(bloom_draw_list *dst, const bloom_draw_list *src)
{
    bloom_u32 i;

    if (!dst || !src || src->vertex_count == 0 || src->index_count == 0 || src->cmd_count == 0)
    {
        return;
    }

    if (dst->vertex_count + src->vertex_count > dst->vertex_capacity ||
        dst->index_count + src->index_count > dst->index_capacity ||
        dst->cmd_count + src->cmd_count > dst->cmd_capacity)
    {
        return;
    }

    memmove(&dst->vertices[src->vertex_count], dst->vertices, sizeof(bloom_vertex) * dst->vertex_count);

    for (i = dst->index_count; i > 0; --i)
    {
        dst->indices[src->index_count + i - 1] = (bloom_draw_idx)(dst->indices[i - 1] + src->vertex_count);
    }

    memmove(&dst->commands[src->cmd_count], dst->commands, sizeof(bloom_draw_cmd) * dst->cmd_count);

    memcpy(dst->vertices, src->vertices, sizeof(bloom_vertex) * src->vertex_count);
    memcpy(dst->indices, src->indices, sizeof(bloom_draw_idx) * src->index_count);
    memcpy(dst->commands, src->commands, sizeof(bloom_draw_cmd) * src->cmd_count);

    dst->vertex_count += src->vertex_count;
    dst->index_count += src->index_count;
    dst->cmd_count += src->cmd_count;
}

static bloom_bool bloom_rect_exact_equal(bloom_rect a, bloom_rect b)
{
    return a.x == b.x && a.y == b.y && a.w == b.w && a.h == b.h;
}

static void bloom_draw_add_cmd(bloom_draw_list *dl, bloom_u32 elem_count)
{
    bloom_rect clip_rect;

    if (dl->clip_depth > 0)
    {
        clip_rect = dl->clip_stack[dl->clip_depth - 1];
    }
    else
    {
        clip_rect = bloom_make_rect(-1, -1, -1, -1);
    }

    if (dl->cmd_count > 0)
    {
        bloom_draw_cmd *prev = &dl->commands[dl->cmd_count - 1];
        if (prev->type == BLOOM_DRAW_CMD_TRIANGLES &&
            prev->texture_id == dl->current_texture &&
            bloom_rect_exact_equal(prev->clip_rect, clip_rect))
        {
            prev->elem_count += elem_count;
            return;
        }
    }

    if (dl->cmd_count >= dl->cmd_capacity)
    {
        return;
    }
    bloom_draw_cmd *cmd = &dl->commands[dl->cmd_count++];
    cmd->type = BLOOM_DRAW_CMD_TRIANGLES;
    cmd->elem_count = elem_count;
    cmd->texture_id = dl->current_texture;
    cmd->clip_rect = clip_rect;
}

void bloom_draw_push_clip(bloom_draw_list *dl, bloom_rect rect)
{
    if (dl->clip_depth < BLOOM_MAX_CLIP_STACK)
    {
        if (dl->clip_depth > 0)
        {
            rect = bloom_rect_intersect(rect, dl->clip_stack[dl->clip_depth - 1]);
        }
        dl->clip_stack[dl->clip_depth++] = rect;
    }
}

void bloom_draw_pop_clip(bloom_draw_list *dl)
{
    if (dl->clip_depth > 0)
    {
        dl->clip_depth--;
    }
}

static bloom_bool bloom_draw_reserve(bloom_draw_list *dl, bloom_u32 vert_count, bloom_u32 idx_count)
{
    return (dl->vertex_count + vert_count <= dl->vertex_capacity) &&
           (dl->index_count + idx_count <= dl->index_capacity);
}

static bloom_vertex bloom_make_vertex(bloom_vec2 pos, bloom_vec2 uv, bloom_u32 col)
{
    bloom_vertex v;
    v.pos = pos;
    v.uv = uv;
    v.col = col;
    return v;
}

static bloom_i32 bloom_draw_curve_segments(bloom_i32 fallback)
{
    bloom_context *ctx = bloom_get_context();
    if (ctx && ctx->style.curve_segments > 2)
    {
        return ctx->style.curve_segments;
    }
    return fallback;
}

static bloom_i32 bloom_draw_circle_segments(bloom_i32 fallback)
{
    bloom_context *ctx = bloom_get_context();
    if (ctx && ctx->style.circle_segments > 2)
    {
        return ctx->style.circle_segments;
    }
    return fallback;
}

static bloom_bool bloom_draw_antialias_shapes(void)
{
    bloom_context *ctx = bloom_get_context();
    return (ctx && ctx->style.antialias_shapes) ? BLOOM_TRUE : BLOOM_FALSE;
}

static bloom_bool bloom_draw_antialias_lines(void)
{
    bloom_context *ctx = bloom_get_context();
    return (ctx && ctx->style.antialias_lines) ? BLOOM_TRUE : BLOOM_FALSE;
}

static bloom_bool bloom_draw_antialias_text(void)
{
    bloom_context *ctx = bloom_get_context();
    return (ctx && ctx->style.antialias_text) ? BLOOM_TRUE : BLOOM_FALSE;
}

static bloom_color bloom_color_scale_alpha(bloom_color color, bloom_f32 scale)
{
    bloom_color out = color;
    bloom_f32 alpha = (bloom_f32)out.a * scale;
    if (alpha < 0.0f) alpha = 0.0f;
    if (alpha > 255.0f) alpha = 255.0f;
    out.a = (bloom_u8)(alpha + 0.5f);
    return out;
}

static void bloom_draw_emit_triangle_colored(bloom_draw_list *dl,
                                             bloom_vec2 a, bloom_color ca,
                                             bloom_vec2 b, bloom_color cb,
                                             bloom_vec2 c, bloom_color cc)
{
    if (!bloom_draw_reserve(dl, 3, 3))
    {
        return;
    }

    {
        bloom_u32 base = dl->vertex_count;
        bloom_vec2 uv = bloom_v2(0, 0);

        dl->vertices[dl->vertex_count++] = bloom_make_vertex(a, uv, bloom_color_to_u32(ca));
        dl->vertices[dl->vertex_count++] = bloom_make_vertex(b, uv, bloom_color_to_u32(cb));
        dl->vertices[dl->vertex_count++] = bloom_make_vertex(c, uv, bloom_color_to_u32(cc));

        dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 0);
        dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 1);
        dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 2);
    }

    bloom_draw_add_cmd(dl, 3);
}

static void bloom_draw_emit_quad_colored(bloom_draw_list *dl,
                                         bloom_vec2 p0, bloom_color c0,
                                         bloom_vec2 p1, bloom_color c1,
                                         bloom_vec2 p2, bloom_color c2,
                                         bloom_vec2 p3, bloom_color c3)
{
    if (!bloom_draw_reserve(dl, 4, 6))
    {
        return;
    }

    {
        bloom_u32 base = dl->vertex_count;
        bloom_vec2 uv = bloom_v2(0, 0);

        dl->vertices[dl->vertex_count++] = bloom_make_vertex(p0, uv, bloom_color_to_u32(c0));
        dl->vertices[dl->vertex_count++] = bloom_make_vertex(p1, uv, bloom_color_to_u32(c1));
        dl->vertices[dl->vertex_count++] = bloom_make_vertex(p2, uv, bloom_color_to_u32(c2));
        dl->vertices[dl->vertex_count++] = bloom_make_vertex(p3, uv, bloom_color_to_u32(c3));

        dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 0);
        dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 1);
        dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 2);
        dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 0);
        dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 2);
        dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 3);
    }

    bloom_draw_add_cmd(dl, 6);
}

static bloom_f32 bloom_draw_polygon_area(const bloom_vec2 *points, bloom_i32 count)
{
    bloom_f32 area = 0.0f;
    bloom_i32 i;

    for (i = 0; i < count; ++i)
    {
        bloom_i32 next = (i + 1) % count;
        area += points[i].x * points[next].y - points[next].x * points[i].y;
    }

    return area * 0.5f;
}

static void bloom_draw_convex_fill_points(bloom_draw_list *dl, const bloom_vec2 *points,
                                          bloom_i32 count, bloom_color col)
{
    bloom_i32 i;

    if (!dl || !points || count < 3 || col.a == 0)
    {
        return;
    }

    for (i = 1; i < count - 1; ++i)
    {
        bloom_draw_triangle(dl, points[0], points[i], points[i + 1], col);
    }

    if (bloom_draw_antialias_shapes())
    {
        bloom_f32 area = bloom_draw_polygon_area(points, count);
        bloom_f32 fringe = 1.0f;
        bloom_color transparent = bloom_color_scale_alpha(col, 0.0f);

        for (i = 0; i < count; ++i)
        {
            bloom_i32 next = (i + 1) % count;
            bloom_f32 dx = points[next].x - points[i].x;
            bloom_f32 dy = points[next].y - points[i].y;
            bloom_f32 len = sqrtf(dx * dx + dy * dy);
            bloom_vec2 normal;

            if (len <= 0.0001f)
            {
                continue;
            }

            if (area >= 0.0f)
            {
                normal = bloom_v2(dy / len, -dx / len);
            }
            else
            {
                normal = bloom_v2(-dy / len, dx / len);
            }

            bloom_draw_emit_quad_colored(dl,
                points[i], col,
                points[next], col,
                bloom_v2(points[next].x + normal.x * fringe, points[next].y + normal.y * fringe), transparent,
                bloom_v2(points[i].x + normal.x * fringe, points[i].y + normal.y * fringe), transparent);
        }
    }
}

static void bloom_draw_rect_filled_basic(bloom_draw_list *dl, bloom_rect rect, bloom_color col)
{
    if (!bloom_draw_reserve(dl, 4, 6))
    {
        return;
    }
    bloom_u32 base = dl->vertex_count;
    bloom_u32 c = bloom_color_to_u32(col);
    bloom_vec2 uv = bloom_v2(0, 0);

    dl->vertices[dl->vertex_count++] = bloom_make_vertex(bloom_v2(rect.x, rect.y), uv, c);
    dl->vertices[dl->vertex_count++] = bloom_make_vertex(bloom_v2(rect.x + rect.w, rect.y), uv, c);
    dl->vertices[dl->vertex_count++] = bloom_make_vertex(bloom_v2(rect.x + rect.w, rect.y + rect.h), uv, c);
    dl->vertices[dl->vertex_count++] = bloom_make_vertex(bloom_v2(rect.x, rect.y + rect.h), uv, c);

    dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 0);
    dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 1);
    dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 2);
    dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 0);
    dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 2);
    dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 3);

    bloom_draw_add_cmd(dl, 6);
}

static void bloom_draw_line_basic(bloom_draw_list *dl, bloom_vec2 a, bloom_vec2 b, bloom_color col, bloom_f32 thickness)
{
    bloom_f32 dx = b.x - a.x;
    bloom_f32 dy = b.y - a.y;
    bloom_f32 len = sqrtf(dx * dx + dy * dy);
    bloom_f32 nx;
    bloom_f32 ny;

    if (len < 0.001f)
    {
        return;
    }

    nx = -dy / len * thickness * 0.5f;
    ny = dx / len * thickness * 0.5f;

    bloom_draw_emit_quad_colored(dl,
        bloom_v2(a.x + nx, a.y + ny), col,
        bloom_v2(b.x + nx, b.y + ny), col,
        bloom_v2(b.x - nx, b.y - ny), col,
        bloom_v2(a.x - nx, a.y - ny), col);
}

static void bloom_draw_circle_filled_basic(bloom_draw_list *dl, bloom_vec2 center, bloom_f32 radius, int segments, bloom_color col)
{
    int i;

    segments = bloom_draw_circle_segments(segments > 0 ? segments : 16);
    for (i = 0; i < segments; i++)
    {
        bloom_f32 a0 = ((bloom_f32)i / (bloom_f32)segments) * 2.0f * (bloom_f32)M_PI;
        bloom_f32 a1 = ((bloom_f32)(i + 1) / (bloom_f32)segments) * 2.0f * (bloom_f32)M_PI;
        bloom_vec2 p0 = bloom_v2(center.x + cosf(a0) * radius, center.y + sinf(a0) * radius);
        bloom_vec2 p1 = bloom_v2(center.x + cosf(a1) * radius, center.y + sinf(a1) * radius);
        bloom_draw_triangle(dl, center, p0, p1, col);
    }
}

static void bloom_draw_build_rounded_rect_points(bloom_rect rect, bloom_f32 radius,
                                                 bloom_vec2 *points, bloom_i32 *count)
{
    bloom_f32 r = radius;
    bloom_f32 start_angles[4];
    bloom_vec2 centers[4];
    bloom_i32 segments;
    bloom_i32 corner;
    bloom_i32 index = 0;

    if (r <= 0.5f)
    {
        points[0] = bloom_v2(rect.x, rect.y);
        points[1] = bloom_v2(rect.x + rect.w, rect.y);
        points[2] = bloom_v2(rect.x + rect.w, rect.y + rect.h);
        points[3] = bloom_v2(rect.x, rect.y + rect.h);
        *count = 4;
        return;
    }

    if (r > rect.w * 0.5f) r = rect.w * 0.5f;
    if (r > rect.h * 0.5f) r = rect.h * 0.5f;

    segments = bloom_draw_curve_segments(8);
    if (segments < 3) segments = 3;
    if (segments > 64) segments = 64;

    centers[0] = bloom_v2(rect.x + r, rect.y + r);
    centers[1] = bloom_v2(rect.x + rect.w - r, rect.y + r);
    centers[2] = bloom_v2(rect.x + rect.w - r, rect.y + rect.h - r);
    centers[3] = bloom_v2(rect.x + r, rect.y + rect.h - r);

    start_angles[0] = (bloom_f32)M_PI;
    start_angles[1] = (bloom_f32)(M_PI * 1.5f);
    start_angles[2] = 0.0f;
    start_angles[3] = (bloom_f32)(M_PI * 0.5f);

    for (corner = 0; corner < 4; ++corner)
    {
        bloom_i32 step;
        for (step = 0; step <= segments; ++step)
        {
            bloom_f32 angle = start_angles[corner] + ((bloom_f32)step / (bloom_f32)segments) * ((bloom_f32)M_PI * 0.5f);
            points[index++] = bloom_v2(centers[corner].x + cosf(angle) * r,
                                       centers[corner].y + sinf(angle) * r);
        }
    }

    *count = index;
}

static void bloom_draw_rect_rounded_basic(bloom_draw_list *dl, bloom_rect rect, bloom_color col, bloom_f32 radius)
{
    int seg;
    bloom_f32 r;
    bloom_vec2 corners[4];
    bloom_f32 start_angles[4];
    int corner;

    if (radius <= 0.5f)
    {
        bloom_draw_rect_filled_basic(dl, rect, col);
        return;
    }

    seg = bloom_draw_curve_segments(8);
    r = radius;
    if (r > rect.w * 0.5f) r = rect.w * 0.5f;
    if (r > rect.h * 0.5f) r = rect.h * 0.5f;

    bloom_draw_rect_filled_basic(dl, bloom_make_rect(rect.x + r, rect.y, rect.w - 2 * r, rect.h), col);
    bloom_draw_rect_filled_basic(dl, bloom_make_rect(rect.x, rect.y + r, r, rect.h - 2 * r), col);
    bloom_draw_rect_filled_basic(dl, bloom_make_rect(rect.x + rect.w - r, rect.y + r, r, rect.h - 2 * r), col);

    corners[0] = bloom_v2(rect.x + r, rect.y + r);
    corners[1] = bloom_v2(rect.x + rect.w - r, rect.y + r);
    corners[2] = bloom_v2(rect.x + rect.w - r, rect.y + rect.h - r);
    corners[3] = bloom_v2(rect.x + r, rect.y + rect.h - r);

    start_angles[0] = (bloom_f32)M_PI;
    start_angles[1] = (bloom_f32)(M_PI * 1.5);
    start_angles[2] = 0.0f;
    start_angles[3] = (bloom_f32)(M_PI * 0.5);

    for (corner = 0; corner < 4; corner++)
    {
        bloom_vec2 center = corners[corner];
        bloom_f32 start = start_angles[corner];
        int i;
        for (i = 0; i < seg; i++)
        {
            bloom_f32 a0 = start + ((bloom_f32)i / (bloom_f32)seg) * ((bloom_f32)M_PI * 0.5f);
            bloom_f32 a1 = start + ((bloom_f32)(i + 1) / (bloom_f32)seg) * ((bloom_f32)M_PI * 0.5f);
            bloom_vec2 p0 = bloom_v2(center.x + cosf(a0) * r, center.y + sinf(a0) * r);
            bloom_vec2 p1 = bloom_v2(center.x + cosf(a1) * r, center.y + sinf(a1) * r);
            bloom_draw_triangle(dl, center, p0, p1, col);
        }
    }
}

void bloom_draw_rect_filled(bloom_draw_list *dl, bloom_rect rect, bloom_color col)
{
    bloom_vec2 points[4];

    if (rect.w <= 0.0f || rect.h <= 0.0f)
    {
        return;
    }

    if (!bloom_draw_antialias_shapes() || rect.w <= 2.0f || rect.h <= 2.0f || col.a == 0)
    {
        bloom_draw_rect_filled_basic(dl, rect, col);
        return;
    }

    points[0] = bloom_v2(rect.x, rect.y);
    points[1] = bloom_v2(rect.x + rect.w, rect.y);
    points[2] = bloom_v2(rect.x + rect.w, rect.y + rect.h);
    points[3] = bloom_v2(rect.x, rect.y + rect.h);
    bloom_draw_convex_fill_points(dl, points, 4, col);
}

void bloom_draw_rect(bloom_draw_list *dl, bloom_rect rect, bloom_color col, bloom_f32 thickness)
{
    bloom_f32 t = thickness;
    bloom_draw_rect_filled_basic(dl, bloom_make_rect(rect.x, rect.y, rect.w, t), col);
    bloom_draw_rect_filled_basic(dl, bloom_make_rect(rect.x, rect.y + rect.h - t, rect.w, t), col);
    bloom_draw_rect_filled_basic(dl, bloom_make_rect(rect.x, rect.y + t, t, rect.h - 2 * t), col);
    bloom_draw_rect_filled_basic(dl, bloom_make_rect(rect.x + rect.w - t, rect.y + t, t, rect.h - 2 * t), col);
}

void bloom_draw_rect_rounded(bloom_draw_list *dl, bloom_rect rect, bloom_color col, bloom_f32 radius)
{
    bloom_vec2 points[260];
    bloom_i32 count = 0;

    if (radius <= 0.5f)
    {
        bloom_draw_rect_filled(dl, rect, col);
        return;
    }

    if (!bloom_draw_antialias_shapes())
    {
        bloom_draw_rect_rounded_basic(dl, rect, col, radius);
        return;
    }

    bloom_draw_build_rounded_rect_points(rect, radius, points, &count);
    bloom_draw_convex_fill_points(dl, points, count, col);
}

void bloom_draw_rect_rounded_border(bloom_draw_list *dl, bloom_rect rect, bloom_color col, bloom_f32 radius, bloom_f32 thickness)
{
    bloom_f32 t = thickness;
    bloom_f32 r = radius;
    bloom_i32 seg;
    bloom_vec2 centers[4];
    bloom_f32 start_angles[4];
    bloom_i32 corner;

    if (t <= 0.0f)
    {
        return;
    }

    if (r <= 0.5f)
    {
        bloom_draw_rect(dl, rect, col, t);
        return;
    }

    if (r > rect.w * 0.5f) r = rect.w * 0.5f;
    if (r > rect.h * 0.5f) r = rect.h * 0.5f;
    if (t > r) t = r;

    bloom_draw_rect_filled_basic(dl, bloom_make_rect(rect.x + r, rect.y, rect.w - 2.0f * r, t), col);
    bloom_draw_rect_filled_basic(dl, bloom_make_rect(rect.x + r, rect.y + rect.h - t, rect.w - 2.0f * r, t), col);
    bloom_draw_rect_filled_basic(dl, bloom_make_rect(rect.x, rect.y + r, t, rect.h - 2.0f * r), col);
    bloom_draw_rect_filled_basic(dl, bloom_make_rect(rect.x + rect.w - t, rect.y + r, t, rect.h - 2.0f * r), col);

    centers[0] = bloom_v2(rect.x + r, rect.y + r);
    centers[1] = bloom_v2(rect.x + rect.w - r, rect.y + r);
    centers[2] = bloom_v2(rect.x + rect.w - r, rect.y + rect.h - r);
    centers[3] = bloom_v2(rect.x + r, rect.y + rect.h - r);

    start_angles[0] = (bloom_f32)M_PI;
    start_angles[1] = (bloom_f32)(M_PI * 1.5);
    start_angles[2] = 0.0f;
    start_angles[3] = (bloom_f32)(M_PI * 0.5);

    seg = bloom_draw_curve_segments(8);
    for (corner = 0; corner < 4; ++corner)
    {
        bloom_vec2 center = centers[corner];
        bloom_f32 start = start_angles[corner];
        bloom_i32 i;
        for (i = 0; i < seg; ++i)
        {
            bloom_f32 a0 = start + ((bloom_f32)i / (bloom_f32)seg) * ((bloom_f32)M_PI * 0.5f);
            bloom_f32 a1 = start + ((bloom_f32)(i + 1) / (bloom_f32)seg) * ((bloom_f32)M_PI * 0.5f);
            bloom_vec2 p0_outer = bloom_v2(center.x + cosf(a0) * r, center.y + sinf(a0) * r);
            bloom_vec2 p1_outer = bloom_v2(center.x + cosf(a1) * r, center.y + sinf(a1) * r);
            bloom_vec2 p0_inner = bloom_v2(center.x + cosf(a0) * (r - t), center.y + sinf(a0) * (r - t));
            bloom_vec2 p1_inner = bloom_v2(center.x + cosf(a1) * (r - t), center.y + sinf(a1) * (r - t));

            bloom_draw_triangle(dl, p0_outer, p1_outer, p1_inner, col);
            bloom_draw_triangle(dl, p0_outer, p1_inner, p0_inner, col);
        }
    }
}

static bloom_f32 bloom_draw_clamp_f32(bloom_f32 value, bloom_f32 min_value, bloom_f32 max_value)
{
    if (value < min_value)
    {
        return min_value;
    }
    if (value > max_value)
    {
        return max_value;
    }
    return value;
}

static bloom_corner_radii bloom_draw_normalize_corner_radii(bloom_rect rect, bloom_corner_radii radii)
{
    bloom_f32 scale = 1.0f;
    bloom_f32 edge_sum;

    radii.top_left = bloom_draw_clamp_f32(radii.top_left, 0.0f, rect.w * 0.5f);
    radii.top_right = bloom_draw_clamp_f32(radii.top_right, 0.0f, rect.w * 0.5f);
    radii.bottom_right = bloom_draw_clamp_f32(radii.bottom_right, 0.0f, rect.w * 0.5f);
    radii.bottom_left = bloom_draw_clamp_f32(radii.bottom_left, 0.0f, rect.w * 0.5f);

    radii.top_left = bloom_draw_clamp_f32(radii.top_left, 0.0f, rect.h * 0.5f);
    radii.top_right = bloom_draw_clamp_f32(radii.top_right, 0.0f, rect.h * 0.5f);
    radii.bottom_right = bloom_draw_clamp_f32(radii.bottom_right, 0.0f, rect.h * 0.5f);
    radii.bottom_left = bloom_draw_clamp_f32(radii.bottom_left, 0.0f, rect.h * 0.5f);

    edge_sum = radii.top_left + radii.top_right;
    if (edge_sum > rect.w && edge_sum > 0.0f)
    {
        bloom_f32 edge_scale = rect.w / edge_sum;
        if (edge_scale < scale) scale = edge_scale;
    }
    edge_sum = radii.bottom_left + radii.bottom_right;
    if (edge_sum > rect.w && edge_sum > 0.0f)
    {
        bloom_f32 edge_scale = rect.w / edge_sum;
        if (edge_scale < scale) scale = edge_scale;
    }
    edge_sum = radii.top_left + radii.bottom_left;
    if (edge_sum > rect.h && edge_sum > 0.0f)
    {
        bloom_f32 edge_scale = rect.h / edge_sum;
        if (edge_scale < scale) scale = edge_scale;
    }
    edge_sum = radii.top_right + radii.bottom_right;
    if (edge_sum > rect.h && edge_sum > 0.0f)
    {
        bloom_f32 edge_scale = rect.h / edge_sum;
        if (edge_scale < scale) scale = edge_scale;
    }

    if (scale < 1.0f)
    {
        radii.top_left *= scale;
        radii.top_right *= scale;
        radii.bottom_right *= scale;
        radii.bottom_left *= scale;
    }

    return radii;
}

static void bloom_draw_build_custom_rect_points(bloom_rect rect, bloom_corner_radii radii,
                                                bloom_vec2 *points, bloom_i32 *count)
{
    bloom_vec2 centers[4];
    bloom_f32 corner_radii[4];
    bloom_f32 start_angles[4];
    bloom_i32 segments;
    bloom_i32 corner;
    bloom_i32 index = 0;

    radii = bloom_draw_normalize_corner_radii(rect, radii);

    if (radii.top_left <= 0.5f && radii.top_right <= 0.5f &&
        radii.bottom_right <= 0.5f && radii.bottom_left <= 0.5f)
    {
        points[0] = bloom_v2(rect.x, rect.y);
        points[1] = bloom_v2(rect.x + rect.w, rect.y);
        points[2] = bloom_v2(rect.x + rect.w, rect.y + rect.h);
        points[3] = bloom_v2(rect.x, rect.y + rect.h);
        *count = 4;
        return;
    }

    segments = bloom_draw_curve_segments(8);
    if (segments < 3) segments = 3;
    if (segments > 64) segments = 64;

    centers[0] = bloom_v2(rect.x + radii.top_left, rect.y + radii.top_left);
    centers[1] = bloom_v2(rect.x + rect.w - radii.top_right, rect.y + radii.top_right);
    centers[2] = bloom_v2(rect.x + rect.w - radii.bottom_right, rect.y + rect.h - radii.bottom_right);
    centers[3] = bloom_v2(rect.x + radii.bottom_left, rect.y + rect.h - radii.bottom_left);

    corner_radii[0] = radii.top_left;
    corner_radii[1] = radii.top_right;
    corner_radii[2] = radii.bottom_right;
    corner_radii[3] = radii.bottom_left;

    start_angles[0] = (bloom_f32)M_PI;
    start_angles[1] = (bloom_f32)(M_PI * 1.5f);
    start_angles[2] = 0.0f;
    start_angles[3] = (bloom_f32)(M_PI * 0.5f);

    for (corner = 0; corner < 4; ++corner)
    {
        bloom_i32 step;
        for (step = 0; step <= segments; ++step)
        {
            bloom_f32 angle = start_angles[corner] + ((bloom_f32)step / (bloom_f32)segments) * ((bloom_f32)M_PI * 0.5f);
            bloom_f32 radius = corner_radii[corner];

            if (radius <= 0.0f)
            {
                switch (corner)
                {
                case 0: points[index] = bloom_v2(rect.x, rect.y); break;
                case 1: points[index] = bloom_v2(rect.x + rect.w, rect.y); break;
                case 2: points[index] = bloom_v2(rect.x + rect.w, rect.y + rect.h); break;
                default: points[index] = bloom_v2(rect.x, rect.y + rect.h); break;
                }
            }
            else
            {
                points[index] = bloom_v2(centers[corner].x + cosf(angle) * radius,
                                         centers[corner].y + sinf(angle) * radius);
            }
            ++index;
        }
    }

    *count = index;
}

static void bloom_draw_rect_custom_fill(bloom_draw_list *dl, bloom_rect rect,
                                        bloom_corner_radii radii, bloom_color col)
{
    bloom_vec2 points[260];
    bloom_i32 count = 0;

    if (!dl || col.a == 0 || rect.w <= 0.0f || rect.h <= 0.0f)
    {
        return;
    }

    bloom_draw_build_custom_rect_points(rect, radii, points, &count);
    bloom_draw_convex_fill_points(dl, points, count, col);
}

static void bloom_draw_rect_custom_ring(bloom_draw_list *dl, bloom_rect rect,
                                        bloom_corner_radii radii, bloom_color col,
                                        bloom_f32 thickness)
{
    bloom_vec2 outer_points[260];
    bloom_vec2 inner_points[260];
    bloom_rect inner_rect;
    bloom_corner_radii inner_radii;
    bloom_i32 count = 0;
    bloom_i32 i;

    if (!dl || col.a == 0 || thickness <= 0.0f || rect.w <= 0.0f || rect.h <= 0.0f)
    {
        return;
    }

    radii = bloom_draw_normalize_corner_radii(rect, radii);
    if (radii.top_left <= 0.5f && radii.top_right <= 0.5f &&
        radii.bottom_right <= 0.5f && radii.bottom_left <= 0.5f)
    {
        bloom_draw_rect(dl, rect, col, thickness);
        return;
    }

    inner_rect = bloom_make_rect(rect.x + thickness, rect.y + thickness,
                                 rect.w - thickness * 2.0f, rect.h - thickness * 2.0f);
    if (inner_rect.w <= 0.0f || inner_rect.h <= 0.0f)
    {
        bloom_draw_rect_custom_fill(dl, rect, radii, col);
        return;
    }

    inner_radii = radii;
    inner_radii.top_left = bloom_draw_clamp_f32(inner_radii.top_left - thickness, 0.0f, inner_rect.w * 0.5f);
    inner_radii.top_right = bloom_draw_clamp_f32(inner_radii.top_right - thickness, 0.0f, inner_rect.w * 0.5f);
    inner_radii.bottom_right = bloom_draw_clamp_f32(inner_radii.bottom_right - thickness, 0.0f, inner_rect.w * 0.5f);
    inner_radii.bottom_left = bloom_draw_clamp_f32(inner_radii.bottom_left - thickness, 0.0f, inner_rect.w * 0.5f);
    inner_radii = bloom_draw_normalize_corner_radii(inner_rect, inner_radii);

    bloom_draw_build_custom_rect_points(rect, radii, outer_points, &count);
    bloom_draw_build_custom_rect_points(inner_rect, inner_radii, inner_points, &count);

    for (i = 0; i < count; ++i)
    {
        bloom_i32 next = (i + 1) % count;
        bloom_draw_triangle(dl, outer_points[i], outer_points[next], inner_points[next], col);
        bloom_draw_triangle(dl, outer_points[i], inner_points[next], inner_points[i], col);
    }
}

void bloom_draw_rect_custom(bloom_draw_list *dl, bloom_rect rect, bloom_color fill_color,
                            bloom_color border_color, bloom_f32 border_thickness,
                            bloom_corner_radii radii)
{
    if (!dl || rect.w <= 0.0f || rect.h <= 0.0f)
    {
        return;
    }

    if (border_color.a > 0 && border_thickness > 0.0f)
    {
        bloom_draw_rect_custom_ring(dl, rect, radii, border_color, border_thickness);
    }

    if (fill_color.a > 0)
    {
        bloom_rect inner_rect = rect;
        bloom_corner_radii inner_radii = radii;

        if (border_color.a > 0 && border_thickness > 0.0f)
        {
            inner_rect = bloom_make_rect(rect.x + border_thickness, rect.y + border_thickness,
                                         rect.w - border_thickness * 2.0f, rect.h - border_thickness * 2.0f);
            inner_radii.top_left = bloom_draw_clamp_f32(inner_radii.top_left - border_thickness, 0.0f, inner_rect.w * 0.5f);
            inner_radii.top_right = bloom_draw_clamp_f32(inner_radii.top_right - border_thickness, 0.0f, inner_rect.w * 0.5f);
            inner_radii.bottom_right = bloom_draw_clamp_f32(inner_radii.bottom_right - border_thickness, 0.0f, inner_rect.w * 0.5f);
            inner_radii.bottom_left = bloom_draw_clamp_f32(inner_radii.bottom_left - border_thickness, 0.0f, inner_rect.w * 0.5f);
        }

        if (inner_rect.w > 0.0f && inner_rect.h > 0.0f)
        {
            bloom_draw_rect_custom_fill(dl, inner_rect, inner_radii, fill_color);
        }
    }
}

void bloom_draw_triangle(bloom_draw_list *dl, bloom_vec2 a, bloom_vec2 b, bloom_vec2 c, bloom_color col)
{
    if (!bloom_draw_reserve(dl, 3, 3))
    {
        return;
    }
    bloom_u32 base = dl->vertex_count;
    bloom_u32 cv = bloom_color_to_u32(col);
    bloom_vec2 uv = bloom_v2(0, 0);

    dl->vertices[dl->vertex_count++] = bloom_make_vertex(a, uv, cv);
    dl->vertices[dl->vertex_count++] = bloom_make_vertex(b, uv, cv);
    dl->vertices[dl->vertex_count++] = bloom_make_vertex(c, uv, cv);

    dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 0);
    dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 1);
    dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 2);

    bloom_draw_add_cmd(dl, 3);
}

void bloom_draw_line(bloom_draw_list *dl, bloom_vec2 a, bloom_vec2 b, bloom_color col, bloom_f32 thickness)
{
    bloom_f32 dx = b.x - a.x;
    bloom_f32 dy = b.y - a.y;
    bloom_f32 len = sqrtf(dx * dx + dy * dy);
    bloom_f32 tx;
    bloom_f32 ty;
    bloom_f32 nx;
    bloom_f32 ny;
    bloom_f32 outer_half;
    bloom_f32 fringe;
    bloom_color transparent;

    if (len < 0.001f)
    {
        return;
    }

    if (!bloom_draw_antialias_lines())
    {
        bloom_draw_line_basic(dl, a, b, col, thickness);
        return;
    }

    tx = dx / len;
    ty = dy / len;
    nx = -dy / len * thickness * 0.5f;
    ny = dx / len * thickness * 0.5f;
    fringe = 1.0f;
    outer_half = thickness * 0.5f + fringe;
    transparent = bloom_color_scale_alpha(col, 0.0f);

    {
        bloom_vec2 i0 = bloom_v2(a.x + nx, a.y + ny);
        bloom_vec2 i1 = bloom_v2(b.x + nx, b.y + ny);
        bloom_vec2 i2 = bloom_v2(b.x - nx, b.y - ny);
        bloom_vec2 i3 = bloom_v2(a.x - nx, a.y - ny);

        bloom_vec2 o0 = bloom_v2(a.x - tx * fringe + (-dy / len) * outer_half,
                                 a.y - ty * fringe + ( dx / len) * outer_half);
        bloom_vec2 o1 = bloom_v2(b.x + tx * fringe + (-dy / len) * outer_half,
                                 b.y + ty * fringe + ( dx / len) * outer_half);
        bloom_vec2 o2 = bloom_v2(b.x + tx * fringe - (-dy / len) * outer_half,
                                 b.y + ty * fringe - ( dx / len) * outer_half);
        bloom_vec2 o3 = bloom_v2(a.x - tx * fringe - (-dy / len) * outer_half,
                                 a.y - ty * fringe - ( dx / len) * outer_half);

        bloom_draw_emit_quad_colored(dl, i0, col, i1, col, i2, col, i3, col);
        bloom_draw_emit_quad_colored(dl, o0, transparent, o1, transparent, i1, col, i0, col);
        bloom_draw_emit_quad_colored(dl, i3, col, i2, col, o2, transparent, o3, transparent);
        bloom_draw_emit_quad_colored(dl, o3, transparent, o0, transparent, i0, col, i3, col);
        bloom_draw_emit_quad_colored(dl, i2, col, i1, col, o1, transparent, o2, transparent);
    }
}

void bloom_draw_circle_filled(bloom_draw_list *dl, bloom_vec2 center, bloom_f32 radius, bloom_color col, int segments)
{
    bloom_color transparent;
    int i;

    segments = bloom_draw_circle_segments(segments > 0 ? segments : 16);
    bloom_draw_circle_filled_basic(dl, center, radius, segments, col);

    if (!bloom_draw_antialias_shapes())
    {
        return;
    }

    transparent = bloom_color_scale_alpha(col, 0.0f);
    for (i = 0; i < segments; i++)
    {
        bloom_f32 a0 = ((bloom_f32)i / (bloom_f32)segments) * 2.0f * (bloom_f32)M_PI;
        bloom_f32 a1 = ((bloom_f32)(i + 1) / (bloom_f32)segments) * 2.0f * (bloom_f32)M_PI;
        bloom_vec2 p0 = bloom_v2(center.x + cosf(a0) * radius, center.y + sinf(a0) * radius);
        bloom_vec2 p1 = bloom_v2(center.x + cosf(a1) * radius, center.y + sinf(a1) * radius);
        bloom_vec2 o0 = bloom_v2(center.x + cosf(a0) * (radius + 1.0f), center.y + sinf(a0) * (radius + 1.0f));
        bloom_vec2 o1 = bloom_v2(center.x + cosf(a1) * (radius + 1.0f), center.y + sinf(a1) * (radius + 1.0f));
        bloom_draw_emit_quad_colored(dl, p0, col, p1, col, o1, transparent, o0, transparent);
    }
}

void bloom_draw_text(bloom_draw_list *dl, bloom_vec2 pos, const char *text,
                     bloom_color col, bloom_f32 font_size, bloom_u32 font_texture)
{
    bloom_draw_text_n(dl, pos, text, (bloom_u32)strlen(text), col, font_size, font_texture);
}

void bloom_draw_text_n(bloom_draw_list *dl, bloom_vec2 pos, const char *text, bloom_u32 text_len,
                      bloom_color col, bloom_f32 font_size, bloom_u32 font_texture)
{
    bloom_font *font = bloom_font_get_active();
    bloom_f32 x = pos.x;
    bloom_f32 y = pos.y;
    bloom_f32 scale = 1.0f;
    bloom_u32 old_tex = dl->current_texture;
    bloom_u32 idx = 0;

    if (font && font->valid && font->size > 0.0f)
    {
        scale = font_size / font->size;
    }

    if (bloom_draw_antialias_text())
    {
        x = floorf(x + 0.5f);
        y = floorf(y + 0.5f);
    }

    dl->current_texture = font_texture;

    while (idx < text_len)
    {
        bloom_u8 ch_u8 = (bloom_u8)text[idx];

        if (ch_u8 == '\n')
        {
            x = pos.x;
            y += font ? font->line_height * scale : font_size;
            idx++;
            continue;
        }

        if (ch_u8 < 32)
        {
            idx++;
            continue;
        }

        bloom_f32 char_w = font_size * 0.55f;
        bloom_f32 char_h = font_size;
        bloom_f32 u0;
        bloom_f32 v0;
        bloom_f32 u1;
        bloom_f32 v1;

        if (font && font->valid && ch_u8 >= 32 && ch_u8 < 128)
        {
            bloom_glyph *glyph = &font->glyphs[ch_u8 - 32];
            char_w = (glyph->x1 - glyph->x0) * scale;
            char_h = (glyph->y1 - glyph->y0) * scale;
            u0 = glyph->u0;
            v0 = glyph->v0;
            u1 = glyph->u1;
            v1 = glyph->v1;
        }
        else
        {
            int ch = ch_u8 - 32;
            bloom_f32 atlas_w = 16.0f;
            bloom_f32 atlas_h = 8.0f;
            u0 = (bloom_f32)(ch % 16) / atlas_w;
            v0 = (bloom_f32)(ch / 16) / atlas_h;
            u1 = u0 + 1.0f / atlas_w;
            v1 = v0 + 1.0f / atlas_h;
        }

        if (bloom_draw_reserve(dl, 4, 6))
        {
            bloom_u32 base = dl->vertex_count;
            bloom_u32 c = bloom_color_to_u32(col);

            dl->vertices[dl->vertex_count++] = bloom_make_vertex(bloom_v2(x, y), bloom_v2(u0, v0), c);
            dl->vertices[dl->vertex_count++] = bloom_make_vertex(bloom_v2(x + char_w, y), bloom_v2(u1, v0), c);
            dl->vertices[dl->vertex_count++] = bloom_make_vertex(bloom_v2(x + char_w, y + char_h), bloom_v2(u1, v1), c);
            dl->vertices[dl->vertex_count++] = bloom_make_vertex(bloom_v2(x, y + char_h), bloom_v2(u0, v1), c);

            dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 0);
            dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 1);
            dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 2);
            dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 0);
            dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 2);
            dl->indices[dl->index_count++] = (bloom_draw_idx)(base + 3);

            bloom_draw_add_cmd(dl, 6);
        }

        if (font && font->valid)
        {
            x += bloom_font_char_width(font, (bloom_u32)ch_u8) * scale;
        }
        else
        {
            x += char_w;
        }
        idx++;
    }

    dl->current_texture = old_tex;
}

bloom_f32 bloom_text_width(const char *text, bloom_f32 font_size)
{
    return bloom_text_width_n(text, (bloom_u32)strlen(text), font_size);
}

bloom_f32 bloom_text_width_n(const char *text, bloom_u32 text_len, bloom_f32 font_size)
{
    bloom_font *font = bloom_font_get_active();
    if (font && font->valid)
    {
        bloom_f32 scale = 1.0f;
        if (font->size > 0.0f)
        {
            scale = font_size / font->size;
        }
        {
            bloom_f32 w = 0;
            bloom_f32 line_w = 0;
            bloom_u32 i;
            for (i = 0; i < text_len; ++i)
            {
                if (text[i] == '\n')
                {
                    if (line_w > w) w = line_w;
                    line_w = 0;
                }
                else
                {
                    line_w += bloom_font_char_width(font, (bloom_u32)(bloom_u8)text[i]) * scale;
                }
            }
            if (line_w > w) w = line_w;
            return w;
        }
    }

    bloom_f32 w = 0;
    bloom_f32 line_w = 0;
    bloom_f32 char_w = font_size * 0.55f;
    bloom_u32 i;
    for (i = 0; i < text_len; ++i)
    {
        if (text[i] == '\n')
        {
            if (line_w > w) w = line_w;
            line_w = 0;
        }
        else
        {
            line_w += char_w;
        }
    }
    if (line_w > w) w = line_w;
    return w;
}
